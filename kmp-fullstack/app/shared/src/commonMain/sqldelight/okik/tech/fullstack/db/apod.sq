CREATE TABLE ApodEntity (
    dateId INTEGER PRIMARY KEY,
    date TEXT NOT NULL,
    copyright TEXT,
    fetchedAt INTEGER NOT NULL,
    explanation TEXT NOT NULL,
    url TEXT NOT NULL,
    hdUrl TEXT,
    media_type TEXT NOT NULL,
    title TEXT NOT NULL,
    thumbnailUrl TEXT
);

upsert:
INSERT OR REPLACE INTO ApodEntity (
    dateId,
    date,
    copyright,
    fetchedAt,
    explanation,
    url,
    hdUrl,
    media_type,
    title,
    thumbnailUrl
)
VALUES ?;

