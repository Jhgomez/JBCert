 deleteAll:
    DELETE FROM
    ApodEntity;

 selectAll:
    SELECT * FROM ApodEntity;

 selectById:
    SELECT * FROM ApodEntity WHERE dateId = :dateId;

 countApods:
    SELECT count(*) FROM ApodEntity;

 apodsPage:
     SELECT *
     FROM ApodEntity
     LIMIT :limit OFFSET :offset;
