import kotlin.Int;

CREATE TABLE News (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  type TEXT NOT NULL,
  time INTEGER NOT NULL,
  by TEXT NOT NULL,
  title TEXT,
  score INTEGER AS Int,
  url TEXT,
  descendants INTEGER AS Int,
  text TEXT
);

selectAll:
SELECT *
FROM News
ORDER BY score DESC;

select:
SELECT *
FROM News
WHERE id = ?;

upsert:
INSERT INTO News (id, type, time, by, title, score, url, descendants, text)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (id)
DO UPDATE SET
    type = excluded.type,
    time = excluded.time,
    by = excluded.by,
    title = excluded.title,
    score = excluded.score,
    url = excluded.url,
    descendants = excluded.descendants,
    text = excluded.text;

insert:
INSERT INTO News(type, time, by, title, score, url, descendants, text)
VALUES ?; -- this generates an object insertion, while if we use (?, ?, ?, ?, ?, ?, ?, ?) is field by field

delete:
DELETE FROM News
WHERE id = ?;