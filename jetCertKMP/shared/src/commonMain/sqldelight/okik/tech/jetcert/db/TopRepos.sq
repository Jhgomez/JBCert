import kotlin.Int;

CREATE TABLE TopRepo (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  url TEXT NOT NULL,
  name TEXT NOT NULL,
  stargazerCount INTEGER AS Int NOT NULL,
  createdAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL
);

selectAll:
SELECT *
FROM TopRepo;

upsert:
INSERT INTO TopRepo (id, url, name, stargazerCount, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT (id)
DO UPDATE SET
     url= excluded.url,
     name= excluded.name,
     stargazerCount= excluded.stargazerCount,
     createdAt= excluded.createdAt,
     updatedAt= excluded.updatedAt;

insert:
INSERT INTO TopRepo (url, name, stargazerCount, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?);

delete:
DELETE FROM TopRepo
WHERE id = ?;